# KEEP YOUR REAL TOKEN PRIVATE. Set DISCORD_TOKEN in your host's environment settings.
DISCORD_TOKEN=your_discord_bot_token_here

# OPTIONAL: register slash commands instantly in one server (leave blank for global commands)
GUILD_ID=

# OPTIONAL: persistent directory (must survive host restarts for room ownership and setup)
DATA_DIR=./data

# OPTIONAL: empty-room cleanup grace period, in seconds (5-300)
EMPTY_GRACE_SECONDS=15

# OPTIONAL: set false to skip automatic registration of the 15 reference-style Discord application emojis
TEMPO_CUSTOM_EMOJIS=true
