# MG3 CREATOR LIVE ALERTS - BRAND NEW INSTALL
# Put these values in Bot-Hosting Startup / Environment Variables.
# Never upload a filled .env or secret tokens to GitHub.

# Required for Discord (new Discord application recommended)
DISCORD_TOKEN=
GUILD_ID=
DATA_DIR=./data

# API keys: configure only the platforms you need
YOUTUBE_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Optional TikTok paid post scraper; may return zero posts for restricted accounts
APIFY_TOKEN=
TIKTOK_APIFY_INTERVAL_MINUTES=360
TIKTOK_APIFY_RESULTS=3

# Scanning rates (seconds unless *_MINUTES). Keep YouTube quota under control.
POLL_SECONDS=15
TWITCH_CHECK_SECONDS=30
KICK_CHECK_SECONDS=30
YOUTUBE_UPLOAD_SECONDS=60
YOUTUBE_READ_DAILY_BUDGET=6000
YOUTUBE_SEARCH_DAILY_BUDGET=90
YOUTUBE_SCAN_HOURS=24
TIKTOK_LIVE_CHECK_SECONDS=60
TIKTOK_POSTS_CHECK_SECONDS=900

# Optional TikTok LIVE detection signing key (only if TikTok LIVE checks get rate limited)
TIKTOK_SIGN_API_KEY=

# Optional YouTube LIVE search window (only matters if YOUTUBE_SCAN_HOURS is below 24)
YOUTUBE_SCAN_TIMEZONE=Asia/Amman
YOUTUBE_SCAN_START_HOUR=6

# Set true only if you intend to announce content that is already live on startup
NOTIFY_ON_STARTUP=false

# Optional incoming HTTPS events: ONLY when real public HTTPS forwarding exists
PORT=3000
PUBLIC_BASE_URL=
YOUTUBE_HUB_SECRET=
TWITCH_WEBHOOK_SECRET=
